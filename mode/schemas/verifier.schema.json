{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ctf-mode verifier backend manifest",
  "description": "An extra verification backend appended to the core chain (syntax -> local repro -> platform). A backend may add evidence but may not bypass the gate.",
  "type": "object",
  "required": ["schema_version", "id", "level", "command", "evidence", "min_core", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^ext-verifier-[a-z0-9-]+$"},
    "level": {"enum": ["syntax", "local_repro", "platform", "extra"]},
    "command": {"type": "string", "description": "Deterministic command; must exit nonzero on failure."},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requires_reproduced": {"type": "boolean", "default": true},
    "min_core": {"type": "string"},
    "provenance": {"type": "object", "required": ["source", "license"]},
    "enabled": {"type": "boolean", "default": false}
  }
}
