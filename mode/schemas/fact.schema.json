{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh.local/ctf-mode/schemas/fact.schema.json",
  "title": "CTF board fact",
  "description": "One fact record as stored in runs/<game>/<chal>/facts.jsonl and mirrored to the blackboard DB. Candidate facts are written by executors; verified facts only by verifier-* actors after reproducible evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim", "evidence", "status", "source", "actor", "ts", "artifact"],
  "properties": {
    "id": {
      "type": "string",
      "description": "fact id (f1, f2, ...), stable within the challenge",
      "pattern": "^f[0-9]+$",
      "minLength": 2,
      "maxLength": 24
    },
    "claim": {
      "type": "string",
      "description": "one independently actionable finding",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "string",
      "description": "concrete provenance: command, output, path",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "verified", "challenged", "retired"]
    },
    "source": {
      "type": "string",
      "enum": ["exec", "read", "web", "tool", "verify"]
    },
    "actor": {
      "type": "string",
      "description": "who wrote the fact; verified facts require actor starting with 'verifier'",
      "minLength": 1,
      "maxLength": 120
    },
    "ts": {
      "type": "string",
      "description": "ISO-8601 timestamp with timezone",
      "format": "date-time",
      "minLength": 10,
      "maxLength": 40
    },
    "artifact": {
      "type": ["string", "null"],
      "description": "artifact path or null",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
