{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ctf-mode category manifest",
  "description": "A new resident category entry. Place the skill under roots/resident/ctf-<id>/ and the manifest under extensions/categories/, then re-run `skillctl ctf index`. Core does not change.",
  "type": "object",
  "required": ["schema_version", "id", "entry", "category", "triggers", "when_not", "provenance", "min_core"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^ctf-[a-z0-9-]+$"},
    "entry": {"type": "string", "pattern": "^roots/resident/ctf-[a-z0-9-]+/SKILL\\.md$"},
    "category": {"type": "string", "minLength": 2},
    "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "when_not": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "reference_index": {"type": "string"},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {"type": "array", "items": {"type": "string"}},
        "models": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "license"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "license": {"type": "string"},
        "hash": {"type": "string"}
      }
    },
    "min_core": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "enabled": {"type": "boolean", "default": true}
  }
}
